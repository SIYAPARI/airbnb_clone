<% layout("/layouts/boilerplate")%>
<body>
    <style>
        #filters{
            margin-top: 1rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            
        }
        .filter{
            margin-right: 2rem;
            margin-top: 1.5rem;
            opacity: 0.7;
        }
        .filter:hover{
            opacity:1;
            cursor: pointer;
        }
        .filter p{
            font-size: 0.75rem;
        }
        .tax-info{
            display:none;
            
        }
        .tax-toggle{
            border:1px solid black !important;
            padding:0.3rem;
            border-radius: 1rem;
            width:150px;
            display:flex;
            justify-content: center;
            align-items: center;
            position: relative;
            z-index: 10;
        }
    </style>
    
    <div id="filters" class="d-flex flex-wrap align-items-center mt-3">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tree-city"></i></div>
            <p>Iconic cities</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beachfront</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-ship"></i></div>
            <p>Boats</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p>Camping</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-skiing"></i></div>
            <p>Skiing</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bowl-food"></i></div>
            <p>Chef's Kitchen</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-sitemap"></i></div>
            <p>Sites</p>
        </div>
        <!-- <div class="filter">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Arctic</p>
        </div> -->
        <div class="tax-toggle ms-auto">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                <label class="form-check-label" for="flexSwitchCheckDefault" style="font-weight: 300;">Display Tax</label>
            </div>
        </div>

    </div>
    
    <div id="search-heading" class="mt-3">
        <% if (typeof q !== 'undefined' && q) { %>
            <h2>Search results for: "<%= q %>"</h2>
        <% } %>
    </div>
    
    <div id="listings-container" class="row row-cols-lg-4 row-cols-md-2 row-cold-sm-1 mt-3">
        <%for (let list of allListings){%>
            <a href="/listing/<%=list._id%>" class="listing-link">
                <div class=" card listing-card" >
                    <img src="<%=list.image.url%>" class="card-img-top" alt="listing_img" style="height:20rem">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                      <p class="card-text">
                        <b><%=list.title%></b>
                        <br/>
                        &#8377;<%=list.price.toLocaleString("en-IN")%>/night
                        <i class="tax-info">&nbsp; +<%=list.tax%>% GST</i>
                    </p>
                    </div>
                </div>
            </a>
                
            
           
        <%}%>
    </div>
    
    
</body>

<script>
    let taxSwitch=document.querySelector("#flexSwitchCheckDefault");
    taxSwitch.addEventListener("click",()=>{
        let tax_info=document.querySelectorAll(".tax-info");
        for (info of tax_info){
            if(info.style.display !="inline"){
                info.style.display="inline";
            }
           else{
            info.style.display="none";
           }
        }
    });
    
    // Dynamic search functionality
    const searchInput = document.getElementById('search-input');
    const listingsContainer = document.getElementById('listings-container');
    const searchForm = document.querySelector('form[role="search"]');
    
    // Prevent form submission to keep dynamic search
    searchForm.addEventListener('submit', function(e) {
        e.preventDefault();
    });
    
    searchInput.addEventListener('input', function() {
        const query = this.value.trim();
        fetchListings(query);
    });
    
    async function fetchListings(query) {
        try {
            const response = await fetch(`/listing/api?q=${encodeURIComponent(query)}`);
            const listings = await response.json();
            renderListings(listings, query);
        } catch (error) {
            console.error('Error fetching listings:', error);
        }
    }
    
    function renderListings(listings, query) {
        const searchHeading = document.getElementById('search-heading');
        let headingHtml = '';
        if (query) {
            headingHtml = `<h2>Search results for: "${query}"</h2>`;
        }
        searchHeading.innerHTML = headingHtml;
        
        let html = '';
        if (listings.length === 0) {
            html += '<p>No listings found.</p>';
        } else {
            listings.forEach(list => {
                html += `
                    <a href="/listing/${list._id}" class="listing-link">
                        <div class="card listing-card">
                            <img src="${list.image.url}" class="card-img-top" alt="listing_img" style="height:20rem">
                            <div class="card-img-overlay"></div>
                            <div class="card-body">
                                <p class="card-text">
                                    <b>${list.title}</b><br/>
                                    &#8377;${list.price.toLocaleString("en-IN")}/night
                                    <i class="tax-info">&nbsp; +${list.tax}% GST</i>
                                </p>
                            </div>
                        </div>
                    </a>
                `;
            });
        }
        listingsContainer.innerHTML = html;
    }
</script>